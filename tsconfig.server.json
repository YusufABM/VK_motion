{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".next/server-build",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["server.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
